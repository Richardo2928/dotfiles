# ============================================
# GRUVED GREEN COLORSCHEME
# ============================================

# Backgrounds
set $bg_primary #282828
set $bg_elevated #504945
set $bg_secondary #89816d
set $bg_lighter #ebdbb2

# Foregrounds
set $fg_primary #fbf1c7
set $fg_dark #282828
set $black #141414

# Accents (Gradiente 4)
set $green_deep #0FA17A
set $green_medium #49CA94
set $green_mint #A4ECA8
set $green_light #D8F8B0

# Alerts
set $red #fb4934
set $yellow #fabd2f
set $orange #d58c5d

# Neutrals
set $blue #83a598

# ============================================
# SWAY WINDOW APPEARANCE
# ============================================

# Configuración de ventanas
# class                     titlebar border     titlebar background     titlebar text   child indicator     border
client.focused              $green_medium       $bg_primary             $fg_primary     $yellow             $green_medium
client.focused_inactive     $bg_lighter         $bg_elevated            $bg_secondary   $orange             $bg_lighter
client.focused_tab_title    $green_medium       $bg_primary             $green_mint
client.unfocused            $blue               $bg_primary             $bg_secondary   $bg_secondary       $blue
client.urgent               $red                $black                  $fg_dark        $orange             $red
