# ============================================
# GRUVED GREEN COLORSCHEME
# ============================================

# Backgrounds
set $bg_primary #282828
set $bg_elevated #504945
set $bg_secondary #89816d
set $bg_lighter #ebdbb2

# Foregrounds
set $fg_primary #fbf1c7
set $fg_dark #282828
set $black #141414

# Accents (Gradiente 4)
set $green_deep #0FA17A
set $green_medium #49CA94
set $green_mint #A4ECA8
set $green_light #D8F8B0

# Alerts
set $red #fb4934
set $yellow #fabd2f
set $orange #d58c5d

# Neutrals
set $blue #83a598

# ============================================
# SWAY WINDOW APPEARANCE
# ============================================

# Configuración de ventanas
# class                 border        background    text          indicator     child_border
client.focused          $green_medium $bg_primary   $fg_primary   $green_mint   $green_medium
client.focused_inactive $bg_elevated  $bg_elevated  $fg_primary   $bg_primary   $bg_elevated
client.focused_tab_title $green_deep  $bg_primary   $green_mint   $bg_primary   $green_deep
client.unfocused        $bg_primary   $bg_primary   $bg_secondary $bg_primary   $bg_primary
client.urgent           $red          $red          $fg_primary   $red          $red
client.placeholder      $bg_primary   $bg_primary   $bg_secondary $bg_primary   $bg_primary
client.background       $bg_primary

# Gaps (espacios entre ventanas) - minimalistas
gaps inner 8
gaps outer 4

# Bordes delgados
default_border pixel 2
default_floating_border pixel 2