# ============================================
# RICE MINIMALISTA SWAY - Productividad Pura
# ============================================

include ./config.d/variables
include ./colorshemes/gruved-green
# include ./config.d/outputs TODO
# include ./config.d/inputs TODO
include ./config.d/autostart

include ./config.d/keybindings


# ============================================
# OPTIMIZACIONES
# ============================================

# Desactivar animaciones (máximo rendimiento)
#seat seat0 xcursor_theme default 16

# Output (monitor) - ajusta según tu pantalla
# output * bg $bg solid_color
output * scale 1

# Idle (suspender tras 10 min de inactividad)
exec swayidle -w \
    timeout 600 'swaylock -f -c 282828' \
    timeout 900 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"'
