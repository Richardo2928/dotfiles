{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "secondary_prompt": {
    "template": "\u2570\u2500\uf105 ",
    "foreground": "#6feb8e",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "\ue285 ",
    "foreground": "#6feb8e",
    "background": "transparent"
  },
  "console_title_template": "[{{ if .Root }}root @ {{ end }}{{ .Shell }} -- in -> {{ .Folder }}]",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "template": " /\\_____/\\ ",
          "foreground": "#6feb8e",
          "type": "text",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if gt .Code 0 }}(-[<#e06c75>0</>].[<#e06c75>0</>]-){{ else }}(-[<#6feb8e> </>].[<#6feb8e> </>]-){{ end }}",
          "foreground": "#6feb8e",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "leading_diamond": "\ue0b2",
          "template": " {{ if .WSL }}\ue712 on {{ end }}{{ .Icon }} ",
          "foreground": "#6feb8e",
          "background": "#151b1b",
          "type": "os",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b2",
          "template": " <#6feb8e>\ueb99</> {{ .UserName }} <#6feb8e>::</> <#6feb8e>\uf108</> {{ .HostName }} ",
          "foreground": "#7eb8da",
          "background": "#2B2D42",
          "type": "session",
          "style": "diamond"
        },
        {
          "template": " \uf489 {{ .Name }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "shell",
          "style": "powerline"
        },
        {
          "template": " \uf09c admin ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "root",
          "style": "powerline"
        },
        {
          "template": " \ue61e \ue61d cmake {{ .Full }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "cmake",
          "style": "powerline"
        },
        {
          "properties": {
            "display_mode": "context"
          },
          "template": " \ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "python",
          "style": "powerline"
        },
        {
          "template": " \u202d\ue626 {{ .Full }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "go",
          "style": "powerline"
        },
        {
          "template": " \ue7a8 {{ .Full }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#6feb8e",
          "type": "rust",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#6feb8e",
          "powerline_symbol": "\ue0b0",
          "background": "#151b1b",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#4a4a4a{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#4a4a4a{{ end }}",
            "{{ if gt .Ahead 0 }}#5a5a5a{{ end }}",
            "{{ if gt .Behind 0 }}#5a5a5a{{ end }}"
          ]
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "foreground": "#6feb8e",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "properties": {
            "charged_icon": "<#ffffff>\ue22f</> ",
            "charging_icon": "\ueb2d ",
            "discharging_icon": "<#ffff00>\uf244</> "
          },
          "style": "plain",
          "template": "--[{{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295]--",
          "type": "battery"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u256d\u2500",
          "foreground": "#D6DEEB",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "time_format": "<#D6DEEB>[ \ue641 15:04:05 ]</> <#6feb8e>[ </> \uf073 2 Jan, Monday <#6feb8e>]</> "
          },
          "template": "{{ .CurrentDate | date .Format }}",
          "foreground": "#6feb8e",
          "type": "time",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "always_enabled": true
          },
          "leading_diamond": "\ue0b6",
          "template": "\ue266 ",
          "foreground": "#3a3a3a",
          "background": "#6abfc6",
          "type": "text",
          "style": "diamond"
        },
        {
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "\ue0b4",
          "template": "RAM: {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB",
          "foreground": "#B6D6F2",
          "background": "#1b1e34",
          "type": "sysinfo",
          "style": "diamond"
        },
        {
          "properties": {
            "always_enabled": true
          },
          "leading_diamond": "\ue0b6",
          "template": " {{ if gt .Code 0 }}\uf00d{{ else }}\uf00c{{ end }} ",
          "foreground": "#6feb8e",
          "background": "#3a3a3a",
          "type": "status",
          "style": "diamond",
          "foreground_templates": ["{{ if gt .Code 0 }}#D6DEEB{{ end }}"],
          "background_templates": ["{{ if gt .Code 0 }}#E44141{{ end }}"]
        },
        {
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "\ue0b4",
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#B6D6F2",
          "background": "#575656",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u251c\u2500",
          "foreground": "#D6DEEB",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "folder_icon": " \uf07c ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\ueb06 ",
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "leading_diamond": "[<#6feb8e> \uf07b </><#B6D6F2> in </>",
          "template": " {{ .Path }} <#D6DEEB>]</>",
          "foreground": "#B6D6F2",
          "type": "path",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u2570\u2500",
          "foreground": "#D6DEEB",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true
          },
          "template": "\u276f ",
          "foreground": "#6feb8e",
          "type": "status",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
